# ---------------------------------------------------------------------------
# Physiotherapy Treatment at Home — appointment enquiry system
# Copy to .env and fill in. PLACEHOLDERS ONLY: never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=production
# Public URL where this app is hosted (used in staff email links and the embed snippet)
APP_URL=https://enquiries.example.com

# PostgreSQL (Supabase, Neon, RDS, or self-hosted). Use a dedicated least-privilege role.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true

# Random secrets, 32+ characters each. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CHAT_TOKEN_SECRET=replace-with-a-different-long-random-secret-32-chars

# Comma-separated origins allowed to embed the chat (the clinic website)
ALLOWED_EMBED_ORIGINS=https://physiotherapytreatmentathome.com,https://www.physiotherapytreatmentathome.com

# ---- AI provider (optional) ----
# none = rule-based only. groq = use Groq to classify free-text intent (it never writes replies).
AI_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_MS=4000

# ---- Staff email notifications ----
# disabled = no email (alerts logged as NOT_CONFIGURED); test = logged only, never delivered; smtp = real delivery
EMAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender address on a domain you control (do not use the clinic's address unless the clinic provides it)
EMAIL_FROM=
# Comma-separated recipients provided by the clinic
STAFF_NOTIFICATION_EMAILS=

# ---- Policy ----
RETENTION_DAYS=365
MAX_ADVANCE_BOOKING_DAYS=90
CLINIC_TIMEZONE=Asia/Kolkata
